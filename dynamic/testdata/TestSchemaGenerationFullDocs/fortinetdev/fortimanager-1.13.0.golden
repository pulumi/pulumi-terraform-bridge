                    "description": "Health-Check. The structure of `{{% ref #/resources/fortimanager:index%2FwantempSystemVirtualwanlink:WantempSystemVirtualwanlink/properties/healthCheck %}}` block is documented below.\n"
                },
                "loadBalanceMode": {
                    "type": "string",
                    "description": "Algorithm or mode to use for load balancing Internet traffic to SD-WAN members. Valid values: `source-ip-based`, `weight-based`, `usage-based`, `source-dest-ip-based`, `measured-volume-based`.\n"
                },
                "members": {
                    "type": "array",
