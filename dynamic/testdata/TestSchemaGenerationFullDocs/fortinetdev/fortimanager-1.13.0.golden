        "fortimanager:index/objectDlpProfileRuleMove:ObjectDlpProfileRuleMove": {
            "description": "Set up DLP rules for this profile.\n\n## Others\n\n\u003e **Warning:** Since the rule changes caused by modifications outside the terraform may be beyond the control of the resource, terraform destroy for the resource will not restore the original sequence state of rules.\n",
            "properties": {
                "adom": {
                    "type": "string",
                    "description": "Adom. This value is valid only when the `{{% ref #/resources/fortimanager:index%2FobjectDlpProfileRuleMove:ObjectDlpProfileRuleMove/properties/scopetype %}}` is `{{% ref #/resources/fortimanager:index%2FobjectDlpProfileRuleMove:ObjectDlpProfileRuleMove/properties/adom %}}`, otherwise the value of adom in the provider will be inherited.\n"
                },
