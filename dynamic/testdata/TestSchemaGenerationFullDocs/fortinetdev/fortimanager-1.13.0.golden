                },
                "tcpTimeoutPid": {
                    "type": "string",
                    "description": "TCP timeout profile ID\n"
                },
                "timeoutSendRst": {
                    "type": "string",
                    "description": "Enable/disable sending RST packets when TCP sessions expire. Valid values: `disable`, `enable`.\n"
                },
                "tos": {
                    "type": "string",
                    "description": "ToS (Type of Service) value used for comparison.\n"
                },
                "tosMask": {
                    "type": "string",
