                "adom": {
                    "type": "string",
                    "description": "Adom. This value is valid only when the `{{% ref #/resources/fortimanager:index%2FobjectExtensioncontrollerExtenderprofileWifi:ObjectExtensioncontrollerExtenderprofileWifi/properties/scopetype %}}` is `{{% ref #/resources/fortimanager:index%2FobjectExtensioncontrollerExtenderprofileWifi:ObjectExtensioncontrollerExtenderprofileWifi/properties/adom %}}`, otherwise the value of adom in the provider will be inherited.\n"
                },
