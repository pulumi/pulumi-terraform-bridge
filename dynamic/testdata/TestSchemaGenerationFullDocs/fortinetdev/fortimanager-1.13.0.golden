                },
                "bandwidthAdmissionControl": {
                    "type": "string",
                    "description": "Enable/disable WiFi multimedia (WMM) bandwidth admission control to optimize WiFi bandwidth use. A request to join the wireless network is only allowed if the access point has enough bandwidth to support it. Valid values: `disable`, `enable`.\n"
                },
                "bandwidthCapacity": {
                    "type": "number",
                    "description": "Maximum bandwidth capacity allowed (1 - 600000 Kbps, default = 2000).\n"
