                    "type": "string",
                    "description": "Enable/disable the explicit FTP proxy on this interface. Valid values: `disable`, `enable`.\n"
                },
                "explicitWebProxy": {
                    "type": "string",
                    "description": "Enable/disable the explicit web proxy on this interface. Valid values: `disable`, `enable`.\n"
                },
