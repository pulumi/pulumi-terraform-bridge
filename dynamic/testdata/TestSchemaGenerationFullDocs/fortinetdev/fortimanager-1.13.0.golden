                },
                "rateTrack": {
                    "type": "string",
                    "description": "Track the packet protocol field. Valid values: `none`, `src-ip`, `dest-ip`, `dhcp-client-mac`, `dns-domain`.\n"
                },
                "risks": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    },
