                        "type": "string",
                        "description": "Download URL for Windows FortiClient.\n"
                    },
                    "winsServer1": {
                        "type": "string",
                        "description": "IPv4 WINS server 1.\n"
                    },
                    "winsServer2": {
                        "type": "string",
                        "description": "IPv4 WINS server 1.\n"
                    }
                },
                "type": "object"
