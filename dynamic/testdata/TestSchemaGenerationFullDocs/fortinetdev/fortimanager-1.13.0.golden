                "includeDfsChannel": {
                    "type": "string",
                    "description": "Enable/disable use of DFS channel in DARRP channel selection phase 1 (default = disable). Valid values: `no`, `disable`, `yes`, `enable`.\n"
                },
                "includeWeatherChannel": {
                    "type": "string",
                    "description": "Enable/disable use of weather channel in DARRP channel selection phase 1 (default = disable). Valid values: `no`, `disable`, `yes`, `enable`.\n"
