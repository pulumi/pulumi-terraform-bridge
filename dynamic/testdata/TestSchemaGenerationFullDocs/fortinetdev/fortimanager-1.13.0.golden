                        "description": "Name of an existing email filter profile.\n"
                    },
                    "fec": {
                        "type": "string",
                        "description": "Enable/disable Forward Error Correction on traffic matching this policy on a FEC device. Valid values: `disable`, `enable`.\n"
                    },
                    "fileFilterProfile": {
                        "type": "string",
                        "description": "Name of an existing file-filter profile.\n"
                    },
                    "firewallSessionDirty": {
