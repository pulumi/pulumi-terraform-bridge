                    "type": "string",
                    "description": "Name of an existing Web application firewall profile.\n"
                },
                "wanopt": {
                    "type": "string",
                    "description": "Enable/disable WAN optimization. Valid values: `disable`, `enable`.\n"
                },
                "wanoptDetection": {
                    "type": "string",
                    "description": "WAN optimization auto-detection mode. Valid values: `active`, `passive`, `off`.\n"
                },
                "wanoptPassiveOpt": {
                    "type": "string",
                    "description": "WAN optimization passive mode options. This option decides what IP address will be used to connect server. Valid values: `default`, `{{% ref #/resources/fortimanager:index%2FpackagesGlobalFooterPolicy:PackagesGlobalFooterPolicy/properties/transparent %}}`, `non-transparent`.\n"
                },
                "wanoptPeer": {
