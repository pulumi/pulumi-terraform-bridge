                },
                "fortilinkSplitInterface": {
                    "type": "string",
                    "description": "Enable/disable FortiLink split interface to connect member link to different FortiSwitch in stack for uplink redundancy. Valid values: `disable`, `enable`.\n"
                },
                "fortilinkStacking": {
                    "type": "string",
