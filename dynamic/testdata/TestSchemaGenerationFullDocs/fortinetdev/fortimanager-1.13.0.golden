                    "type": "number",
                    "description": "Id.\n"
                },
                "ldapMemberof": {
                    "type": "string",
                    "description": "Ldap-Memberof.\n"
                },
                "logicType": {
                    "type": "string",
                    "description": "Logic-Type. Valid values: `or`, `and`.\n"
                },
                "matches": {
                    "type": "array",
                    "items": {
                        "$ref": "#/types/fortimanager:index/ObjectUserGroupDynamicMappingMatch:ObjectUserGroupDynamicMappingMatch"
                    },
                    "description": "Match. The structure of `{{% ref #/resources/fortimanager:index%2FobjectUserGroup:ObjectUserGroup/properties/match %}}` block is documented below.\n"
                },
