                    "type": "number",
                    "description": "IPv6 reachable time (milliseconds; 0 means unspecified).\n"
                },
                "ip6RetransTime": {
                    "type": "number",
                    "description": "IPv6 retransmit time (milliseconds; 0 means unspecified).\n"
                },
                "ip6SendAdv": {
