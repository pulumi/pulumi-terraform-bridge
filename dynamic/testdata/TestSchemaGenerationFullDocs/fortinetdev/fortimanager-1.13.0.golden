                        "arpReply",
                        "embeddedIpv4Address",
                        "extport",
                        "h2Support",
                        "h3Support",
                        "httpCookieAge",
                        "httpCookieDomainFromHost",
                        "httpCookieShare",
                        "httpIpHeader",
                        "httpMultiplex",
                        "httpRedirect",
                        "httpsCookieSecure",
                        "ipv4Mappedport",
                        "ldbMethod",
                        "mappedport",
                        "maxEmbryonicConnections",
                        "nat64",
                        "nat66",
                        "natSourceVip",
                        "ndpReply",
                        "outlookWebAccess",
                        "persistence",
                        "portforward",
                        "protocol",
                        "srcFilters",
                        "srcVipFilter",
                        "sslAcceptFfdheGroups",
                        "sslClientFallback",
                        "sslHsts",
                        "sslHstsAge",
                        "sslHstsIncludeSubdomains",
                        "sslHttpLocationConversion",
                        "sslServerAlgorithm",
                        "sslServerMaxVersion",
                        "sslServerMinVersion",
                        "sslServerRenegotiation",
                        "sslServerSessionStateType",
                        "type",
                        "uuid",
