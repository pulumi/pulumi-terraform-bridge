                },
                "upstream": {
                    "type": "string",
                    "description": "IP/FQDN of the FortiGate upstream from this FortiGate in the Security Fabric.\n"
                },
                "upstreamConfirm": {
                    "type": "string",
                    "description": "Upstream authorization confirm. discover - Discover upstream device\u0026apos;s info. confirm - Confirm upstream device\u0026apos;s access. Valid values: `discover`, `confirm`.\n"
                },
                "upstreamPort": {
                    "type": "number",
                    "description": "The port number to use to communicate with the FortiGate upstream from this FortiGate in the Security Fabric (default = 8013).\n"
                }
            },
