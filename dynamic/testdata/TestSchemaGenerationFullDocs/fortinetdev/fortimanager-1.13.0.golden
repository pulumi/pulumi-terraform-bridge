                    "type": "string",
                    "description": "Enable/disable DDNS update for DHCP. Valid values: `disable`, `{{% ref #/resources/fortimanager:index%2FobjectFspVlanDynamicMappingDhcpserver:ObjectFspVlanDynamicMappingDhcpserver/properties/enable %}}`.\n"
                },
                "ddnsUpdateOverride": {
