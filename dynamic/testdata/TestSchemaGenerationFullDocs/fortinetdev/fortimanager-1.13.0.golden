                    "type": "string",
                    "description": "Auto-Managed-Status. Valid values: `disable`, `{{% ref #/resources/fortimanager:index%2FobjectFspVlanDynamicMappingDhcpserver:ObjectFspVlanDynamicMappingDhcpserver/properties/enable %}}`.\n"
                },
                "conflictedIpTimeout": {
                    "type": "number",
                    "description": "Time in seconds to wait after a conflicted IP address is removed from the DHCP range before it can be reused.\n"
                },
                "ddnsAuth": {
                    "type": "string",
                    "description": "DDNS authentication mode. Valid values: `disable`, `tsig`.\n"
                },
                "ddnsKey": {
                    "type": "string",
                    "description": "DDNS update key (base 64 encoding).\n"
