                    },
                    "smbNtlmv1Auth": {
                        "type": "string",
                        "description": "Enable support of NTLMv1 for Samba authentication. Valid values: `disable`, `enable`.\n"
                    },
                    "smbv1": {
                        "type": "string",
                        "description": "Smbv1. Valid values: `disable`, `enable`.\n"
                    },
                    "splitDns": {
                        "type": "array",
                        "items": {
                            "$ref": "#/types/fortimanager:index/ObjectVpnSslWebPortalSplitDn:ObjectVpnSslWebPortalSplitDn"
                        },
