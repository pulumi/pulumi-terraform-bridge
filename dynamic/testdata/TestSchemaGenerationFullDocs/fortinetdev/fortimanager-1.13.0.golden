                    "type": "string",
                    "description": "Profile name.\n"
                },
                "objectSctpfilterProfileId": {
                    "type": "string",
                    "description": "an identifier for the resource with format {{name}}.\n"
                },
                "ppidFilters": {
                    "type": "array",
                    "items": {
                        "$ref": "#/types/fortimanager:index/ObjectSctpfilterProfilePpidFilter:ObjectSctpfilterProfilePpidFilter"
