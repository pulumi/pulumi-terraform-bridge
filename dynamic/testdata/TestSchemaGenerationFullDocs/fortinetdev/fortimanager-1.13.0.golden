        "fortimanager:index/objectIpsSensorEntriesMove:ObjectIpsSensorEntriesMove": {
            "description": "IPS sensor filter.\n\n## Example Usage\n\n\u003c!--Start PulumiCodeChooser --\u003e\n```typescript\nimport * as pulumi from \"@pulumi/pulumi\";\nimport * as fortimanager from \"@pulumi/fortimanager\";\n\nconst trnameObjectIpsSensor = new fortimanager.ObjectIpsSensor(\"trname\", {name: \"terr-sensor\"});\nconst trnameObjectIpsSensorEntries = new fortimanager.ObjectIpsSensorEntries(\"trname\", {\n    sensor: trnameObjectIpsSensor.name,\n    fosid: 23,\n}, {\n    dependsOn: [trnameObjectIpsSensor],\n});\nconst trname2 = new fortimanager.ObjectIpsSensorEntries(\"trname2\", {\n    sensor: trnameObjectIpsSensor.name,\n    fosid: 24,\n}, {\n    dependsOn: [trnameObjectIpsSensor],\n});\nconst trname = new fortimanager.ObjectIpsSensorEntriesMove(\"trname\", {\n    sensor: trnameObjectIpsSensor.name,\n    entries: trnameObjectIpsSensorEntries.fosid.apply(x =\u003eString(x)),\n    target: trname2.fosid.apply(x =\u003eString(x)),\n    option: \"after\",\n}, {\n    dependsOn: [\n        trnameObjectIpsSensorEntries,\n        trname2,\n    ],\n});\n```\n```python\nimport pulumi\nimport pulumi_fortimanager as fortimanager\n\ntrname_object_ips_sensor = fortimanager.ObjectIpsSensor(\"trname\", name=\"terr-sensor\")\ntrname_object_ips_sensor_entries = fortimanager.ObjectIpsSensorEntries(\"trname\",\n    sensor=trname_object_ips_sensor.name,\n    fosid=float(23),\n    opts = pulumi.ResourceOptions(depends_on=[trname_object_ips_sensor]))\ntrname2 = fortimanager.ObjectIpsSensorEntries(\"trname2\",\n    sensor=trname_object_ips_sensor.name,\n    fosid=float(24),\n    opts = pulumi.ResourceOptions(depends_on=[trname_object_ips_sensor]))\ntrname = fortimanager.ObjectIpsSensorEntriesMove(\"trname\",\n    sensor=trname_object_ips_sensor.name,\n    entries=trname_object_ips_sensor_entries.fosid.apply(lambda x: str(x)),\n    target=trname2.fosid.apply(lambda x: str(x)),\n    option=\"after\",\n    opts = pulumi.ResourceOptions(depends_on=[\n            trname_object_ips_sensor_entries,\n            trname2,\n        ]))\n```\n```csharp\nusing System.Collections.Generic;\nusing System.Linq;\nusing Pulumi;\nusing Fortimanager = Pulumi.Fortimanager;\n\nreturn await Deployment.RunAsync(() =\u003e \n{\n    var trnameObjectIpsSensor = new Fortimanager.ObjectIpsSensor(\"trname\", new()\n    {\n        Name = \"terr-sensor\",\n    });\n\n    var trnameObjectIpsSensorEntries = new Fortimanager.ObjectIpsSensorEntries(\"trname\", new()\n    {\n        Sensor = trnameObjectIpsSensor.Name,\n        Fosid = 23,\n    }, new CustomResourceOptions\n    {\n        DependsOn =\n        {\n            trnameObjectIpsSensor,\n        },\n    });\n\n    var trname2 = new Fortimanager.ObjectIpsSensorEntries(\"trname2\", new()\n    {\n        Sensor = trnameObjectIpsSensor.Name,\n        Fosid = 24,\n    }, new CustomResourceOptions\n    {\n        DependsOn =\n        {\n            trnameObjectIpsSensor,\n        },\n    });\n\n    var trname = new Fortimanager.ObjectIpsSensorEntriesMove(\"trname\", new()\n    {\n        Sensor = trnameObjectIpsSensor.Name,\n        Entries = trnameObjectIpsSensorEntries.Fosid,\n        Target = trname2.Fosid,\n        Option = \"after\",\n    }, new CustomResourceOptions\n    {\n        DependsOn =\n        {\n            trnameObjectIpsSensorEntries,\n            trname2,\n        },\n    });\n\n});\n```\n```go\npackage main\n\nimport (\n\t\"github.com/pulumi/pulumi-terraform-provider/sdks/go/fortimanager/fortimanager\"\n\t\"github.com/pulumi/pulumi/sdk/v3/go/pulumi\"\n)\n\nfunc main() {\n\tpulumi.Run(func(ctx *pulumi.Context) error {\n\t\ttrnameObjectIpsSensor, err := fortimanager.NewObjectIpsSensor(ctx, \"trname\", \u0026fortimanager.ObjectIpsSensorArgs{\n\t\t\tName: pulumi.String(\"terr-sensor\"),\n\t\t})\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\ttrnameObjectIpsSensorEntries, err := fortimanager.NewObjectIpsSensorEntries(ctx, \"trname\", \u0026fortimanager.ObjectIpsSensorEntriesArgs{\n\t\t\tSensor: trnameObjectIpsSensor.Name,\n\t\t\tFosid:  pulumi.Float64(23),\n\t\t}, pulumi.DependsOn([]pulumi.Resource{\n\t\t\ttrnameObjectIpsSensor,\n\t\t}))\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\ttrname2, err := fortimanager.NewObjectIpsSensorEntries(ctx, \"trname2\", \u0026fortimanager.ObjectIpsSensorEntriesArgs{\n\t\t\tSensor: trnameObjectIpsSensor.Name,\n\t\t\tFosid:  pulumi.Float64(24),\n\t\t}, pulumi.DependsOn([]pulumi.Resource{\n\t\t\ttrnameObjectIpsSensor,\n\t\t}))\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\t_, err = fortimanager.NewObjectIpsSensorEntriesMove(ctx, \"trname\", \u0026fortimanager.ObjectIpsSensorEntriesMoveArgs{\n\t\t\tSensor:  trnameObjectIpsSensor.Name,\n\t\t\tEntries: trnameObjectIpsSensorEntries.Fosid,\n\t\t\tTarget:  trname2.Fosid,\n\t\t\tOption:  pulumi.String(\"after\"),\n\t\t}, pulumi.DependsOn([]pulumi.Resource{\n\t\t\ttrnameObjectIpsSensorEntries,\n\t\t\ttrname2,\n\t\t}))\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\treturn nil\n\t})\n}\n```\n```hcl\npulumi {\n  required_providers {\n    fortimanager = {\n      source = \"pulumi/fortimanager\"\n    }\n  }\n}\n\nresource \"fortimanager_objectipssensorentriesmove\" \"trname\" {\n  depends_on = [fortimanager_objectipssensorentries.trname, fortimanager_objectipssensorentries.trname2]\n  sensor     = fortimanager_objectipssensor.trname.name\n  entries    = fortimanager_objectipssensorentries.trname.fosid\n  target     = fortimanager_objectipssensorentries.trname2.fosid\n  option     = \"after\"\n}\nresource \"fortimanager_objectipssensorentries\" \"trname\" {\n  depends_on = [fortimanager_objectipssensor.trname]\n  sensor     = fortimanager_objectipssensor.trname.name\n  fosid      = 23\n}\nresource \"fortimanager_objectipssensorentries\" \"trname2\" {\n  depends_on = [fortimanager_objectipssensor.trname]\n  sensor     = fortimanager_objectipssensor.trname.name\n  fosid      = 24\n}\nresource \"fortimanager_objectipssensor\" \"trname\" {\n  name = \"terr-sensor\"\n}\n```\n```java