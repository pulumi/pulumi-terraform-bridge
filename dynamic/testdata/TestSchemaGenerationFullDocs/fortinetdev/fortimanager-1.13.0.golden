                "deviceaction": {
                    "type": "string",
                    "description": "Specify add device operations, or leave blank to add real device:\u003cul\u003e\u003cli\u003e\"addModel\" - add a model device.\u003cli\u003e\"promoteUnreg\" - promote an unregistered device to be managed by FortiManager using information from database.\u003c/ul\u003e\n"
                },
                "deviceblueprint": {
                    "type": "string",
                    "description": "\u003ci\u003eadd model device only\u003c/i\u003e. Device blueprint to apply to the new model device.\n"
                },
                "fazquota": {
                    "type": "number",
                    "description": "\u003ci\u003eavailable for all operations\u003c/i\u003e.\n"
