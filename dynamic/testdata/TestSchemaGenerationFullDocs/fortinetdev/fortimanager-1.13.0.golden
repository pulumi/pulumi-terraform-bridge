                    "type": "string",
                    "description": "Response IP expected from DNS server.\n"
                },
                "dnsProtocol": {
                    "type": "string",
                    "description": "Select the protocol used by the DNS health check monitor to check the health of the server (UDP | TCP). Valid values: `udp`, `tcp`.\n"
                },
