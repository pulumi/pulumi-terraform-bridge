re\",\n    }, new CustomResourceOptions\n    {\n        DependsOn =\n        {\n            trname,\n            trname2,\n        },\n    });\n\n});\n```\n```go\npackage main\n\nimport (\n\t\"github.com/pulumi/pulumi-terraform-provider/sdks/go/fortimanager/fortimanager\"\n\t\"github.com/pulumi/pulumi/sdk/v3/go/pulumi\"\n)\n\nfunc main() {\n\tpulumi.Run(func(ctx *pulumi.Context) error {\n\t\ttrname, err := fortimanager.NewObjectFirewallAccessproxy6(ctx, \"trname\", \u0026fortimanager.ObjectFirewallAccessproxy6Args{\n\t\t\tName: pulumi.String(\"terr-accessproxy66\"),\n\t\t})\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\ttrname2, err := fortimanager.NewObjectFirewallAccessproxy6(ctx, \"trname2\", \u0026fortimanager.ObjectFirewallAccessproxy6Args{\n\t\t\tName: pulumi.String(\"terr-accessproxy67\"),\n\t\t})\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\t_, err = fortimanager.NewObjectFirewallAccessproxy6Move(ctx, \"trname2\", \u0026fortimanager.ObjectFirewallAccessproxy6MoveArgs{\n\t\t\tAccessProxy6: pulumi.String(\"terr-accessproxy66\"),\n\t\t\tTarget:       pulumi.String(\"terr-accessproxy67\"),\n\t\t\tOption:       pulumi.String(\"before\"),\n\t\t}, pulumi.DependsOn([]pulumi.Resource{\n\t\t\ttrname,\n\t\t\ttrname2,\n\t\t}))\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\treturn nil\n\t})\n}\n```\n```hcl\npulumi {\n  required_providers {\n    fortimanager = {\n      source = \"pulumi/fortimanager\"\n    }\n  }\n}\n\nresource \"fortimanager_objectfirewallaccessproxy6\" \"trname\" {\n  name = \"terr-accessproxy66\"\n}\nresource \"fortimanager_objectfirewallaccessproxy6\" \"trname2\" {\n  name = \"terr-accessproxy67\"\n}\nresource \"fortimanager_objectfirewallaccessproxy6move\" \"trname2\" {\n  depends_on    = [fortimanager_objectfirewallaccessproxy6.trname, fortimanager_objectfirewallaccessproxy6.trname2]\n  access_proxy6 = \"terr-accessproxy66\"\n  target        = \"terr-accessproxy67\"\n  option        = \"before\"\n}\n```\n```java\npackage generated_progr