                "adom": {
                    "type": "string",
                    "description": "Adom. This value is valid only when the `{{% ref #/resources/fortimanager:index%2FobjectDlpDictionary:ObjectDlpDictionary/properties/scopetype %}}` is `{{% ref #/resources/fortimanager:index%2FobjectDlpDictionary:ObjectDlpDictionary/properties/adom %}}`, otherwise the value of adom in the provider will be inherited.\n"
                },
                "comment": {
                    "type": "string",
                    "description": "Optional comments.\n"
                },
                "dynamicSortSubtable": {
                    "type": "string",
                    "description": "true or false, set this parameter to true when using dynamic forEach + toset to configure and sort sub-tables, please do not set this parameter when configuring static sub-tables.\n"
                },
