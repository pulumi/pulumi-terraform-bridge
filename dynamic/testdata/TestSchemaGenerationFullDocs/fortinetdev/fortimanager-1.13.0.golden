            "description": "Move IPv6 policies.\n\n## Example Usage\n\n\u003c!--Start PulumiCodeChooser --\u003e\n```typescript\nimport * as pulumi from \"@pulumi/pulumi\";\nimport * as fortimanager from \"@pulumi/fortimanager\";\n\nconst trname2 = new fortimanager.PackagesFirewallPolicy6(\"trname2\", {\n    dstaddr: \"all\",\n    dstintf: \"any\",\n    pkg: \"default\",\n    policyid: 2,\n    schedule: \"always\",\n    service: \"ALL\",\n    srcaddr: \"all\",\n    srcintf: \"any\",\n});\nconst trname3 = new fortimanager.PackagesFirewallPolicy6(\"trname3\", {\n    dstaddr: \"all\",\n    dstintf: \"any\",\n    pkg: \"default\",\n    policyid: 3,\n    schedule: \"always\",\n    service: \"ALL\",\n    srcaddr: \"all\",\n    srcintf: \"any\",\n});\nconst trname = new fortimanager.PackagesFirewallPolicy6Move(\"trname\", {\n    pkg: \"default\",\n    policy6: \"2\",\n    target: \"3\",\n    option: \"before\",\n}, {\n    dependsOn: [\n        trname2,\n        trname3,\n    ],\n});\n```\n```python\nimport pulumi\nimport pulumi_fortimanager as fortimanager\n\ntrname2 = fortimanager.PackagesFirewallPolicy6(\"trname2\",\n    dstaddr=\"all\",\n    dstintf=\"any\",\n    pkg=\"default\",\n    policyid=float(2),\n    schedule=\"always\",\n    service=\"ALL\",\n    srcaddr=\"all\",\n    srcintf=\"any\")\ntrname3 = fortimanager.PackagesFirewallPolicy6(\"trname3\",\n    dstaddr=\"all\",\n    dstintf=\"any\",\n    pkg=\"default\",\n    policyid=float(3),\n    schedule=\"always\",\n    service=\"ALL\",\n    srcaddr=\"all\",\n    srcintf=\"any\")\ntrname = fortimanager.PackagesFirewallPolicy6Move(\"trname\",\n    pkg=\"default\",\n    policy6=\"2\",\n    target=\"3\",\n    option=\"before\",\n    opts = pulumi.ResourceOptions(depends_on=[\n            trname2,\n            trname3,\n        ]))\n```\n```csharp\nusing System.Collections.Generic;\nusing System.Linq;\nusing Pulumi;\nusing Fortimanager = Pulumi.Fortimanager;\n\nreturn await Deployment.RunAsync(() =\u003e \n{\n    var trna