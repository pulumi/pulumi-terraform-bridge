                },
                "failAlertInterfaces": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Physical interfaces that will be alerted.\n"
                },
                "failDetect": {
                    "type": "string",
                    "description": "Enable/disable SD-WAN Internet connection status checking (failure detection). Valid values: `disable`, `enable`.\n"
                },
