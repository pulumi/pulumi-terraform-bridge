                    "type": "string",
                    "description": "Block unrecognized SIP requests (enabled by default). Valid values: `disable`, `enable`.\n"
                },
                "blockUpdate": {
                    "type": "string",
                    "description": "Enable/disable block UPDATE requests. Valid values: `disable`, `enable`.\n"
