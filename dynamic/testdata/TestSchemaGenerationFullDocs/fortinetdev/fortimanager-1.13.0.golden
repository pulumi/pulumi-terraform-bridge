                        "icmp6SendRedirect",
                        "interfaceIdentifier",
                        "ip6Address",
                        "ip6Allowaccesses",
                        "ip6DefaultLife",
                        "ip6DnsServerOverride",
                        "ip6ManageFlag",
                        "ip6MaxInterval",
                        "ip6MinInterval",
                        "ip6Mode",
                        "ip6OtherFlag",
                        "ip6PrefixMode",
                        "ip6SendAdv",
                        "ip6Subnet",
                        "ndMode",
                        "raSendMtu",
                        "uniqueAutoconfAddr",
                        "vrip6LinkLocal",
                        "vrrpVirtualMac6"
