                "callTimeout",
                "capabilities",
                "cloudServerType",
                "dirtyReason",
                "fortinetoneCloudAuthentication",
                "httpsPort",
                "objectEndpointcontrolFctemsId",
                "interfaceSelectMethod",
                "name",
                "outOfSyncThreshold",
                "preserveSslSession",
                "pullAvatars",
                "pullMalwareHash",
                "pullSysinfo",
                "pullTags",
                "pullVulnerabilities",
                "sendTagsToAllVdoms",
                "sourceIp",
                "status",
                "statusCheckInterval",
                "trustCaCn",
                "websocketOverride"
            ],
            "inputProperties": {
                "adminPasswords": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "FortiClient EMS admin password.\n",
                    "secret": true
