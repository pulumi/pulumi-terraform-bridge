                    "description": "WAN optimization passive mode options. This option decides what IP address will be used to connect server. Valid values: `default`, `transparent`, `non-transparent`.\n"
                },
                "wanoptPeer": {
                    "type": "string",
                    "description": "WAN optimization peer.\n"
                },
                "wanoptProfile": {
                    "type": "string",
                    "description": "WAN optimization profile.\n"
                },
                "wccp": {
                    "type": "string",
                    "description": "Enable/disable forwarding traffic matching this policy to a configured WCCP server. Valid values: `disable`, `enable`.\n"
                },
                "webcache": {
                    "type": "string",
                    "description": "Enable/disable web cache. Valid values: `disable`, `enable`.\n"
                },
                "webcacheHttps": {
                    "type": "string",
                    "description": "Enable/disable web cache for HTTPS. Valid values: `disable`, `ssl-server`, `any`, `enable`.\n"
                },
                "webfilterProfile": {
                    "type": "string",
                    "description": "Name of an existing Web filter profile.\n"
                },
                "webproxyForwardServer": {
                    "type": "string",
                    "description": "Webproxy forward server name.\n"
                },
                "webproxyProfile": {
                    "type": "string",
                    "description": "Webproxy profile name.\n"
                },
                "wsso": {
                    "type": "string",
                    "description": "Enable/disable WiFi Single Sign On (WSSO). Valid values: `disable`, `enable`.\n"
                },
                "ztnaDeviceOwnership": {
                    "type": "string",
                    "description": "Enable/disable zero trust device ownership. Valid values: `disable`, `enable`.\n"
                },
                "ztnaEmsTag": {
                    "type": "string",
                    "description": "Source ztna-ems-tag names.\n"
                },
                "ztnaEmsTagSecondaries": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Source ztna-ems-tag-secondary names.\n"
                },
                "ztnaGeoTag": {
                    "type": "string",
                    "description": "Source ztna-geo-tag names.\n"
                },
                "ztnaPolicyRedirect": {
                    "type": "string",
                    "description": "Redirect ZTNA traffic to matching Access-Proxy proxy-policy. Valid values: `disable`, `enable`.\n"
                },
                "ztnaStatus": {
                    "type": "string",
                    "description": "Enable/disable zero trust access. Valid values: `disable`, `enable`.\n"
                },
                "ztnaTagsMatchLogic": {
                    "type": "string",
                    "description": "ZTNA tag matching logic. Valid values: `or`, `and`.\n"
                }
            },
            "required": [
                "action",
                "antiReplay",
