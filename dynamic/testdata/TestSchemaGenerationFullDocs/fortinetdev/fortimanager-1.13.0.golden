                    "type": "string",
                    "description": "IEEE 802.11 Service Set Identifier.\n"
                },
                "wifiUsergroup": {
                    "type": "string",
                    "description": "WiFi user group for WPA.\n"
                },
                "winsIp": {
                    "type": "string",
                    "description": "WINS server IP.\n"
                }
