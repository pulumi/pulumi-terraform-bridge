                    "type": "string",
                    "description": "Fdp. Valid values: `disable`, `enable`.\n"
                },
                "fortiheartbeat": {
                    "type": "string",
                    "description": "Fortiheartbeat. Valid values: `disable`, `enable`.\n"
                },
                "fortilink": {
