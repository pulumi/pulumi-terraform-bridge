                        "description": "SUBSCRIBE request rate limit (per second, per policy).\n"
                    },
                    "subscribeRateTrack": {
                        "type": "string",
                        "description": "Track the packet protocol field. Valid values: `none`, `src-ip`, `dest-ip`.\n"
