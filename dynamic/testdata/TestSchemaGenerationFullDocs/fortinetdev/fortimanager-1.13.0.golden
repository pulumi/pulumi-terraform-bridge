.builder()\n                .dependsOn(                \n                    trnameObjectIpsSensorEntries,\n                    trname2)\n                .build());\n\n    }\n}\n```\n```yaml\nresources:\n  trname:\n    type: fortimanager:ObjectIpsSensorEntriesMove\n    properties:\n      sensor: ${trnameObjectIpsSensor.name}\n      entries: ${trnameObjectIpsSensorEntries.fosid}\n      target: ${trname2.fosid}\n      option: after\n    options:\n      dependsOn:\n        - ${trnameObjectIpsSensorEntries}\n        - ${trname2}\n  trnameObjectIpsSensorEntries:\n    type: fortimanager:ObjectIpsSensorEntries\n    name: trname\n    properties:\n      sensor: ${trnameObjectIpsSensor.name}\n      fosid: 23\n    options:\n      dependsOn:\n        - ${trnameObjectIpsSensor}\n  trname2:\n    type: fortimanager:ObjectIpsSensorEntries\n    properties:\n      sensor: ${trnameObjectIpsSensor.name}\n      fosid: 24\n    options:\n      dependsOn:\n        - ${trnameObjectIpsSensor}\n  trnameObjectIpsSensor:\n    type: fortimanager:ObjectIpsSensor\n    name: trname\n    properties:\n      name: terr-sensor\n```\n\u003c!--End PulumiCodeChooser --\u003e\n\n## Others\n\n\u003e **Warning:** Since the entries changes caused by modifications outside the terraform may be beyond the control of the resource, terraform destroy for the resource will not restore the original sequence state of entry.\n",
