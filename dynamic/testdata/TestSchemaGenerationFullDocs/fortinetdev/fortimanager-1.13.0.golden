                "dynamicBypass": {
                    "type": "string",
                    "description": "Dynamic-Bypass. Valid values: `disable`, `enable`.\n"
                },
                "dynamicProfile": {
                    "type": "string",
                    "description": "Dynamic-Profile. Valid values: `disable`, `enable`.\n"
