                    "description": "Names of users, peers, LDAP severs, or RADIUS servers to add to the user group.\n"
                },
                "mobilePhone": {
                    "type": "string",
                    "description": "Enable/disable the guest user mobile phone number field. Valid values: `disable`, `enable`.\n"
                },
