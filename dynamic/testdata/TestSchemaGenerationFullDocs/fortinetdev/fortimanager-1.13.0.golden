                        "diskioPeriod",
                        "logRateTopn",
                        "logRateType",
                        "numEntries",
                        "refreshInterval",
                        "resCpuDisplay",
                        "resPeriod",
                        "resViewType",
                        "status",
                        "timePeriod"
                    ]
                }
            }
