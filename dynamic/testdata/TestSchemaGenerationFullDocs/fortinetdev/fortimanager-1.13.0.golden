                    "description": "LDAP server CN domain name or IP.\n"
                },
                "serverIdentityCheck": {
                    "type": "string",
                    "description": "Enable/disable LDAP server identity check (verify server domain name/IP address against the server certificate). Valid values: `disable`, `enable`.\n"
                },
                "sourceIp": {
