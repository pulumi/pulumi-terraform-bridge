This example declares nothing besides provider config, so it should render only the Pulumi config

## Example Usage

```bash
pulumi config set simple:userName admin
pulumi config set --secret simple:password pwd
```


## Example With A Resource

This example also declares a resource, so it should still render a language chooser

```bash
pulumi config set simple:userName admin
```

{{< chooser language "typescript,python,go,csharp,java,yaml,hcl" >}}
{{% choosable language typescript %}}
```typescript
import * as pulumi from "@pulumi/pulumi";
import * as simple from "@pulumi/simple";

const aResource = new simple.index.Resource("a_resource", {renamedInput1: "hello"});
```
{{% /choosable %}}
{{% choosable language python %}}
```python
import pulumi
import pulumi_simple as simple

a_resource = simple.Resource("a_resource", renamed_input1=hello)
```
{{% /choosable %}}
{{% choosable language csharp %}}
```csharp
using System.Collections.Generic;
using System.Linq;
using Pulumi;
using Simple = Pulumi.Simple;

return await Deployment.RunAsync(() => 
{
    var aResource = new Simple.Resource("a_resource", new()
    {
        RenamedInput1 = "hello",
    });

});

```
{{% /choosable %}}
{{% choosable language go %}}
```go
package main

import (
	"github.com/pulumi/pulumi-simple/sdk/go/simple"
	"github.com/pulumi/pulumi/sdk/v3/go/pulumi"
)

func main() {
	pulumi.Run(func(ctx *pulumi.Context) error {
		_, err := simple.NewResource(ctx, "a_resource", &simple.ResourceArgs{
			RenamedInput1: "hello",
		})
		if err != nil {
			return err
		}
		return nil
	})
}
```
{{% /choosable %}}
{{% choosable language yaml %}}
```yaml
resources:
  aResource:
    type: simple:resource
    name: a_resource
    properties:
      renamedInput1: hello
```
{{% /choosable %}}
{{% choosable language java %}}
```java
package generated_program;

import com.pulumi.Context;
import com.pulumi.Pulumi;
import com.pulumi.core.Output;
import com.pulumi.simple.Resource;
import com.pulumi.simple.ResourceArgs;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.Map;
import java.io.File;
import java.nio.file.Files;
import java.nio.file.Paths;

public class App {
    public static void main(String[] args) {
        Pulumi.run(App::stack);
    }

    public static void stack(Context ctx) {
        var aResource = new Resource("aResource", ResourceArgs.builder()
            .renamedInput1("hello")
            .build());

    }
}
```
